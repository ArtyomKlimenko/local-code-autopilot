# Base installation directory. Defaults to C:\LocalAI when omitted.
LOCAL_AI_ROOT=C:\LocalAI

# Model metadata. Configure the hash and byte count to make launcher checks strict.
LOCAL_CODE_MODEL_PATH=C:\LocalAI\models\your-model.gguf
LOCAL_CODE_MODEL_SHA256=
LOCAL_CODE_MODEL_BYTES=

# Exact device name reported by `llama-server --list-devices`.
LOCAL_CODE_GPU_NAME=AMD Radeon RX 5700 XT

# Optional AMD Vulkan ICD JSON if the system selects an unstable driver.
LOCAL_CODE_VULKAN_ICD=

# Optional Alya integration. Leave empty to disable it.
LOCAL_CODE_ALYA_ROOT=

# Default autopilot configuration.
LOCAL_CODE_AUTOPILOT_CONFIG=

# Defaults used by `local-autopilot new`.
LOCAL_AUTOPILOT_DEFAULT_REMOTE_HOST=user@vm-host
LOCAL_AUTOPILOT_SSH_KEY=C:\Users\your-user\.ssh\id_ed25519
